# Copy to .env and adjust as needed (scripts/start.sh does this for you on first run).
# Read by docker compose and by scripts/start-local.sh.
#
# Default setup (nothing to change): three containers
#   models - Ollama with the embedder (bge-m3) and the LLM (qwen3.5:4b)
#   web    - web UI + API
#   qdrant - vector database
# Point OLLAMA_URL / EMBEDDING_API_URL / LLM_API_URL at other servers to use
# models from a URL instead; the models container is then not started.

# =====================================================================
# LLM (answers, question generation)
# =====================================================================
# LLM_MODE picks where the LLM runs:
#   ollama - an Ollama server. Leave OLLAMA_URL empty to use the models container
#            (model auto-pulled), or set it to any Ollama URL:
#              http://host.docker.internal:11434   (Ollama installed on this PC)
#              http://gpu-server:11434             (remote machine)
#   api    - any OpenAI-compatible /v1/chat/completions endpoint (vLLM, LM Studio,
#            llama.cpp server, OpenAI, hivecore, ...) at LLM_API_URL.
#   local  - load a HuggingFace model directly into the web process
#            (transformers; needs LOCAL_MODELS=true).
LLM_MODE=ollama

# --- LLM_MODE=ollama ---
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=

# --- LLM_MODE=api ---
# Base URL (".../v1") or the full ".../v1/chat/completions" endpoint.
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=

# --- LLM_MODE=local ---
# Any HuggingFace instruct/chat model; downloaded once, cached in the hf_cache volume.
LLM_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct

LLM_MAX_NEW_TOKENS=512
LLM_TIMEOUT=300
# Ollama only: let "thinking" models (qwen3, qwen3.5, ...) reason before answering.
# Better on hard questions but several times slower.
LLM_THINK=false

# =====================================================================
# Embeddings
# =====================================================================
# EMBEDDING_MODE:
#   api   - an embedding endpoint. EMBEDDING_API_URL empty = the embedding model on
#           the same Ollama as the LLM (the models container by default). Otherwise
#           any OpenAI-compatible ".../v1/embeddings", Ollama ".../api/embed" or
#           FAMNIT's hivecore URL. EMBEDDING_API_KEY is optional (Bearer token).
#   local - sentence-transformers model loaded in the web process (needs LOCAL_MODELS=true).
#
# !! Changing the embedder changes the vectors: re-initialize afterwards with
#    scripts/init.sh --reset (or use a new QDRANT_COLLECTION).
EMBEDDING_MODE=api
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=bge-m3

# Only used when EMBEDDING_MODE=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Install PyTorch + sentence-transformers into the web image (Docker) - only needed
# for EMBEDDING_MODE=local, LLM_MODE=local or RERANK_MODE=local. Makes the image
# several GB bigger.
LOCAL_MODELS=false

# =====================================================================
# Retrieval
# =====================================================================
# How many document chunks are retrieved and given to the LLM per question.
# More = more context (better recall) but slower, longer prompts. Overridable
# per request (`top_k` in POST /ask, the Top-k field in the web UI).
TOP_K=4

# RETRIEVAL_MODE:
#   hybrid - vector search (meaning) + BM25 keyword search (exact words, names,
#            numbers), fused with reciprocal rank fusion. Recommended.
#   vector - vector search only
#   bm25   - keyword search only
RETRIEVAL_MODE=hybrid

# Reranker: re-scores the RERANK_CANDIDATES best chunks with a cross-encoder and
# keeps the top_k best. Clearly better retrieval; fast on a GPU (~0.1-0.3 s per
# question), slow on CPU (~5 s).
#   off   - no reranker
#   api   - RERANK_API_URL empty: the reranker in the models container, next to
#           Ollama, on the GPU (the models image then also gets PyTorch, ~+5 GB;
#           the model, ~2 GB, is downloaded on first start).
#           RERANK_API_URL set: any /rerank endpoint (Cohere/Jina-style: llama.cpp
#           server --reranking, Infinity, vLLM, or Hugging Face TEI).
#   local - RERANK_MODEL loaded in the web process, on CPU (needs LOCAL_MODELS=true)
RERANK_MODE=off
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=
RERANK_API_KEY=
RERANK_CANDIDATES=20

# --- Chunking ---
# Documents are cut into chunks of at most CHUNK_MAX_CHARS characters (on sentence
# boundaries), with CHUNK_OVERLAP_SENTENCES sentences repeated between neighbours.
# !! Only applies to new ingests: re-initialize with scripts/init.sh --reset after changing.
CHUNK_MAX_CHARS=300
CHUNK_OVERLAP_SENTENCES=1

# =====================================================================
# Qdrant
# =====================================================================
# Leave QDRANT_URL empty to use the bundled Qdrant (docker) / http://127.0.0.1:6333
# (start-local.sh). Set it to use an external Qdrant instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=Beees

# --- Auto-ingest on first startup ---
# On first boot (i.e. the Qdrant collection is empty), the web container
# extracts and embeds every .pdf/.txt/.docx/.xls file under AUTO_INGEST_DIR.
# dataset/data is the study material; dataset/questions holds quiz questions
# (used by eval_rag.py), which only add noise to retrieval.
# Runs in the background so the server is usable immediately; subsequent
# restarts skip it once the collection already has data.
AUTO_INGEST_ENABLED=true
AUTO_INGEST_DIR=dataset/data

# --- Qdrant connection resilience ---
# On flaky/shared infrastructure, direct Qdrant calls (search, upsert, etc.) are
# retried automatically with exponential backoff. A background heartbeat also
# pings Qdrant periodically and logs only when reachability changes, both to
# keep the connection warm and to give you a timestamped record of outages.
QDRANT_HEARTBEAT_ENABLED=true
QDRANT_HEARTBEAT_INTERVAL_SECONDS=15

# --- GPU ---
# NVIDIA GPU for the models container: auto (use it if Docker has the nvidia
# runtime), true, or false.
MODELS_GPU=auto

# --- Network ---
# Address the published ports listen on. 127.0.0.1 = only reachable from this
# machine (use an SSH tunnel); recommended on shared servers.
BIND_HOST=0.0.0.0

# --- Host port overrides ---
# On a shared server, these host ports may already be taken by another container/
# service. Uncomment and change if `docker compose up` fails with
# "port is already allocated".
# RAG_API_HOST_PORT=8000
# QDRANT_HOST_PORT=6333
# OLLAMA_HOST_PORT=11434
