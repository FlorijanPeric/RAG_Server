# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Ollama ---
# Any model tag from https://ollama.com/library (pulled automatically on startup)
OLLAMA_MODEL=llama3.2

# --- Embeddings ---
# "local" runs sentence-transformers inside the rag-api container (no external dependency).
# "api" calls an external embedding endpoint (e.g. FAMNIT's hivecore embedding server).
EMBEDDING_MODE=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only used when EMBEDDING_MODE=api
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# --- Qdrant ---
QDRANT_COLLECTION=Beees

# --- Auto-ingest on first startup ---
# On first boot (i.e. the Qdrant collection is empty), the rag-api container
# automatically extracts and embeds every .pdf/.txt file under AUTO_INGEST_DIR.
# Runs in the background so the server is usable immediately; subsequent
# restarts skip it once the collection already has data.
AUTO_INGEST_ENABLED=true
AUTO_INGEST_DIR=dataset

# --- Qdrant connection resilience ---
# On flaky/shared infrastructure, direct Qdrant calls (search, upsert, etc.) are
# retried automatically with exponential backoff. A background heartbeat also
# pings Qdrant periodically and logs only when reachability changes, both to
# keep the connection warm and to give you a timestamped record of outages.
QDRANT_HEARTBEAT_ENABLED=true
QDRANT_HEARTBEAT_INTERVAL_SECONDS=15

# --- Host port overrides ---
# On a shared server, these host ports may already be taken by another container/
# service. Uncomment and change if `docker compose up` fails with
# "port is already allocated".
# RAG_API_HOST_PORT=8000
# QDRANT_HOST_PORT=6333
# OLLAMA_HOST_PORT=11434
